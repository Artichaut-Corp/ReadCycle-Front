--- 
import {ViewTransitions} from 'astro:transitions';
import Header from '../components/Header.svelte';
import Chat from '../components/Chat.svelte';

interface Props {
	title: string;
}

const { title } = Astro.props; 

const locals = Astro.locals;
let data = locals.pb.authStore
			
let isChatDeployed: boolean = false;

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description">
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/logo.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ViewTransitions />
		</head>
	<body class="bg-base-200">
    	<Header userData={data}/>
		<main class="flex flex-col w-full place-items-center">
			<slot/>
				<div id="chat" class="collapse">
				<Chat isDeployed={isChatDeployed}/>
			</div>
		</main>
		<script is:inline>
			const chatButton = document.getElementById('displayChat');
			const chat = document.getElementById('chat');

			chatButton.addEventListener("click", () => {
				chat.classList.toggle("collapse");
			})

		</script>
		<style is:global>
			/* Improve Page speed */
			/* https://css-tricks.com/almanac/properties/c/content-visibility/ */
			img {
			  content-visibility: auto;
			}
		  </style>
	</body>
</html>

